   attachments: vec text;
   deliverableType: text;
   deliveredAt: Time;
   id: text;
   month: text;
   notes: text;
   scoreImpact: opt nat;
   status: text;
   subscriptionId: text;
   summary: text;
   tenantId: TenantId;
   title: text;
 };
type AgentCommandResult = 
 record {
   actionId: text;
   error: opt text;
   preview: text;
   requiresConfirmation: bool;
 };
type AgentArtifactRecord = 
 record {
   agentId: text;
   artifactType: text;
   clientVisible: bool;
   content: text;
