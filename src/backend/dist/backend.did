   id: text;
   importance: nat;
   memoryType: text;
   tenantId: text;
   threadId: text;
 };
type AgentMemory = 
 record {
   agentNotes: opt text;
   conversationHistory: vec ConversationEntry;
   lastUpdated: int;
   summary: opt text;
   tenantId: text;
   threadId: text;
 };
type AgentLogEntryInput = 
 record {
   action: text;
   actionType: text;
   agentId: text;
   isSuccess: bool;
   logId: text;
   result: text;
   timestamp: int;
 };
type AgentLogEntry = 
 record {
   action: text;
   actionType: text;
   agentId: text;
   isSuccess: bool;
   logId: text;
   result: text;
   timestamp: int;
 };
type AgentDeliverable = 
