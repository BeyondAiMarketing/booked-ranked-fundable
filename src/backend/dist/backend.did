service : {
  _initializeAccessControl: () -> ();
  activateBrandKitTrial: (slug: text, actionType: text) ->
   (variant {
      err: text;
      ok: BrandKitProspect;
    });
  activateTrial: (sessionId: text, firstName: text, businessName: text, city:
   text, niche: text, phone: text, email: text, website: text) ->
   (variant {
      err: text;
      ok:
       record {
         emailWarning: opt text;
         loginUrl: text;
         trialAccountId: text;
       };
    });
  activateTrialForDemo: (sessionId: text, email: text) ->
   (variant {
      err: text;
      ok: record {trialEndsAt: int;};
    });
  addActivityFeedItem: (item: ActivityFeedItemInput) -> ();
  addAgentLog: (entry: AgentLogEntryInput) -> ();
  addAttributionTouch: (id: text, touch: AttributionTouch) -> (bool);
  addConversationMessage: (tenantId: text, sessionId: text, role: text,
   content: text) -> ();
  addDemoFunnelEntry: (entry: DemoFunnelEntry) -> ();
  addInboundReply: (reply: InboundReply) -> ();
  addLeadFromSocialComment: (tenantId: text, commentId: text, _leadData:
   text) -> ();
  addPaidAdsScore: (score: PaidAdsScore) -> ();
  addPipelineLead: (lead: PipelineLead) -> ();
  addScanPhoto: (modelId: text, tenantId: text, storageUrl: text) -> (text);
  addSeoGeoScore: (score: SeoGeoScore) -> ();
  addSeoGeoVisibilitySnapshot: (snapshot: SeoGeoVisibilitySnapshot) -> ();
  addSmsMessage: (threadId: text, tenantId: text, direction: text, sender:
   text, "text": text) -> (variant {
                             err: text;
                             ok: SMSMessage;
                           });
  addTriggerRule: (rule: TriggerRuleInput) -> (TriggerRule);
  addWebsiteAgentScore: (score: WebsiteAgentScore) -> ();
  advanceWarmupDay: () -> ();
  analyzeReply: (replyId: text, leadId: text, replyText: text, niche:
   text) -> (ReplyAnalysis);
  appendAuditLog: (entry: AuditLogEntry) -> ();
  approveAndPushToCrm: (jobId: text, tenantId: text) -> (bool);
  approveBrowserAudit: (jobId: text, tenantId: text, actorName: text) ->
   (variant {
      err: text;
      ok;
    });
  approveEngagement: (tenantId: text, approvalId: text) -> ();
  approveQueuedAction: (actionId: text) -> ();
  approveReplyDraft: (inboxItemId: text) -> (bool);
  archiveSmsThread: (threadId: text) -> (variant {
                                           err: text;
                                           ok: bool;
                                         });
  archiveThread: (id: text) -> (bool);
  assignCallerUserRole: (user: principal, role: UserRole) -> ();
  assignSegmentToQueue: (queueId: text, leadEmails: vec text) -> (bool);
  autoAuditLeads: (tenantId: text, leads_in: vec GeneratedLead) ->
   (variant {
      err: text;
      ok: nat;
