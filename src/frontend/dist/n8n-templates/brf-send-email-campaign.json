{
  "name": "BRF - Send Email Campaign",
  "nodes": [
    {
      "parameters": {},
      "id": "trigger-1",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "webhookId": "brf-send-email-campaign"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "{{$credentials.brfApiUrl}}/api/webhooks/send-email-campaign",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "body": {
          "campaignId": "={{ $json.body.campaignId }}",
          "recipientEmail": "={{ $json.body.recipientEmail }}",
          "subject": "={{ $json.body.subject }}",
          "bodyHtml": "={{ $json.body.bodyHtml }}",
          "bodyText": "={{ $json.body.bodyText }}",
          "fromName": "={{ $json.body.fromName }}",
          "fromEmail": "={{ $json.body.fromEmail }}",
          "vertical": "={{ $json.body.vertical }}",
          "dryRun": false
        },
        "options": {}
      },
      "id": "http-1",
      "name": "Send Email Campaign in BRF",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-1",
              "leftValue": "={{ $json.status }}",
              "rightValue": 200,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "if-1",
      "name": "Success?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [650, 300]
    },
    {
      "parameters": {
        "jsCode": "console.log('Email campaign sent successfully:', $input.first().json); return $input.all();"
      },
      "id": "code-1",
      "name": "Log Success",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [850, 200]
    },
    {
      "parameters": {
        "jsCode": "console.error('Email campaign failed:', $input.first().json); return $input.all();"
      },
      "id": "code-2",
      "name": "Log Failure",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [850, 400]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Send Email Campaign in BRF",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Email Campaign in BRF": {
      "main": [
        [
          {
            "node": "Success?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Success?": {
      "main": [
        [
          {
            "node": "Log Success",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Log Failure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": [
    {
      "name": "BRF",
      "color": "#FFD700"
    },
    {
      "name": "Email",
      "color": "#00BFFF"
    }
  ],
  "description": "Sends approved email campaigns via SendGrid or Caffeine native email. Pulls campaign data from BRF Campaign Builder and handles unsubscribe links and compliance."
}
