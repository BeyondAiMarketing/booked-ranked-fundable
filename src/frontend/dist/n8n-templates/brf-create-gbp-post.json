{
  "name": "BRF - Create GBP Post",
  "nodes": [
    {
      "parameters": {},
      "id": "trigger-1",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "webhookId": "brf-create-gbp-post"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "{{$credentials.brfApiUrl}}/api/webhooks/create-gbp-post",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "body": {
          "businessName": "={{ $json.body.businessName }}",
          "postContent": "={{ $json.body.postContent }}",
          "postType": "={{ $json.body.postType || 'update' }}",
          "ctaType": "={{ $json.body.ctaType || 'none' }}",
          "ctaUrl": "={{ $json.body.ctaUrl }}",
          "vertical": "={{ $json.body.vertical }}",
          "dryRun": false
        },
        "options": {}
      },
      "id": "http-1",
      "name": "Create GBP Post in BRF",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-1",
              "leftValue": "={{ $json.status }}",
              "rightValue": 200,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "if-1",
      "name": "Success?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [650, 300]
    },
    {
      "parameters": {
        "jsCode": "console.log('GBP post created successfully:', $input.first().json); return $input.all();"
      },
      "id": "code-1",
      "name": "Log Success",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [850, 200]
    },
    {
      "parameters": {
        "jsCode": "console.error('GBP post creation failed:', $input.first().json); return $input.all();"
      },
      "id": "code-2",
      "name": "Log Failure",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [850, 400]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Create GBP Post in BRF",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create GBP Post in BRF": {
      "main": [
        [
          {
            "node": "Success?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Success?": {
      "main": [
        [
          {
            "node": "Log Success",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Log Failure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": [
    {
      "name": "BRF",
      "color": "#FFD700"
    },
    {
      "name": "GBP",
      "color": "#00BFFF"
    }
  ],
  "description": "Creates Google Business Profile posts from BRF GBP Post Drafts. Pulls approved drafts from the Approval Queue and publishes them via the Google Business API."
}
