{
  "name": "BRF - Generate Monthly Report",
  "nodes": [
    {
      "parameters": {},
      "id": "trigger-1",
      "name": "Webhook Trigger",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [250, 300],
      "webhookId": "brf-generate-report"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "{{$credentials.brfApiUrl}}/api/webhooks/generate-report",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "contentType": "json",
        "body": {
          "clientBusinessId": "={{ $json.body.clientBusinessId }}",
          "reportType": "={{ $json.body.reportType || 'monthly' }}",
          "month": "={{ $json.body.month }}",
          "year": "={{ $json.body.year }}",
          "vertical": "={{ $json.body.vertical }}",
          "dryRun": false
        },
        "options": {}
      },
      "id": "http-1",
      "name": "Generate Report in BRF",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [450, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "cond-1",
              "leftValue": "={{ $json.status }}",
              "rightValue": 200,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "if-1",
      "name": "Success?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [650, 300]
    },
    {
      "parameters": {
        "jsCode": "console.log('Report generated successfully:', $input.first().json); return $input.all();"
      },
      "id": "code-1",
      "name": "Log Success",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [850, 200]
    },
    {
      "parameters": {
        "jsCode": "console.error('Report generation failed:', $input.first().json); return $input.all();"
      },
      "id": "code-2",
      "name": "Log Failure",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [850, 400]
    }
  ],
  "connections": {
    "Webhook Trigger": {
      "main": [
        [
          {
            "node": "Generate Report in BRF",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate Report in BRF": {
      "main": [
        [
          {
            "node": "Success?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Success?": {
      "main": [
        [
          {
            "node": "Log Success",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Log Failure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "staticData": null,
  "tags": [
    {
      "name": "BRF",
      "color": "#FFD700"
    },
    {
      "name": "Reports",
      "color": "#00BFFF"
    }
  ],
  "description": "Generates monthly performance reports for clients. Pulls data from BRF analytics, formats it into branded PDF/HTML, and delivers via email or client portal."
}
